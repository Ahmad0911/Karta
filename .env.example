# Base URL of the Karta API (NestJS). Payments and everything real need it.
VITE_API_URL=http://localhost:3000/api

# Digits with country code. Shows the WhatsApp button and per-product inquiry link.
VITE_WHATSAPP_NUMBER=

# Which payment provider your BACKEND uses. The storefront only needs the name.
#   mock                                    development only (fake gateway; ignored in production builds)
#   paystack | flutterwave | monnify | ...  anything your API supports
VITE_PAYMENT_PROVIDER=mock

# Phone/email verification codes: mock (development only) | http (your API sends the SMS/email).
# Default: mock in development, http in production. See src/modules/verification.
VITE_VERIFICATION_PROVIDER=mock
