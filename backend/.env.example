# --- Runtime -------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=3000
# SQLite file (Phase 1). Use ":memory:" for throwaway runs.
DATABASE_PATH=./data/karta.db

# --- Security ------------------------------------------------------------
# Required in production: 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Exact origins allowed to call the API (comma separated). Never use *.
CORS_ORIGINS=http://localhost:5173
# Set true ONLY behind a trusted reverse proxy (so X-Forwarded-For is honoured).
TRUST_PROXY=false

# --- Verification codes --------------------------------------------------
# console = print codes to the server log (development only; refused in production)
# none    = send nothing (use until an SMS/email provider is wired in)
NOTIFIER=console
# Return codes in API responses so the frontend can show them (never in production).
EXPOSE_DEV_CODES=true

# --- Payments (Paystack) ---------------------------------------------------
# SERVER ONLY. Never put this in the frontend or commit it. Use sk_test_… while building.
# Dashboard → Settings → API Keys. Set the webhook URL there to:
#   https://YOUR-API-HOST/api/payments/webhook/paystack
PAYSTACK_SECRET_KEY=

# --- Sending codes (required in production) --------------------------------
# NOTIFIER=console prints codes (development only). NOTIFIER=live sends real SMS + email:
#   SMS   → Termii   (termii.com): API key + an approved Sender ID. TERMII_CHANNEL=dnd reaches numbers on Nigeria's Do-Not-Disturb list.
#   Email → Resend   (resend.com): API key + a sender on a domain you have verified.
# NOTIFIER=live
# TERMII_API_KEY=
# TERMII_SENDER_ID=Karta
# TERMII_CHANNEL=dnd
# RESEND_API_KEY=
# EMAIL_FROM=Karta <hello@yourdomain.com>
